# Profile helpers for L.O.T.U.S. (never commit real secrets).
#
# AI model / provider: use Hermes setup — do not hand-edit keys as the primary path:
#   lotus setup
#   lotus setup model
# The wizard writes provider credentials and model.default into this profile.

# Provider keys below are normally filled by `lotus setup` (shown for reference)
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional messaging (separate bot tokens recommended for L.O.T.U.S.)
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=

# --- Gateway / Lotus frontend ---
GATEWAY_RELAY_DISPLAY_NAME=L.O.T.U.S.

API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
# Generated by ./install.sh if left blank; or: openssl rand -hex 32
API_SERVER_KEY=
# API_SERVER_CORS_ORIGINS=http://127.0.0.1:8787

LOTUS_UI_HOST=127.0.0.1
LOTUS_UI_PORT=8787
LOTUS_API_BASE=http://127.0.0.1:8642/v1
# Stable across UI restarts when binding beyond localhost
# Generated by ./install.sh if missing — keep stable across UI restarts
# LOTUS_UI_SESSION_SECRET=
# LOTUS_UI_RATE_LIMIT=30
# LOTUS_UI_RATE_WINDOW=60

# Crisis resource regions (comma-separated): US,CA,GB,AU,NZ,IE,IN,INTL
# Also persisted in memories/lotus-core/prefs.json via the UI region picker
# LOTUS_CRISIS_REGIONS=US,INTL
# LOTUS_PREFERRED_LANG=en
# Soft autodetect from message cues when lang is unlocked (prefs.lang_locked=false).
# Explicit prefs set / LOTUS_PREFERRED_LANG always win.

# Optional: pip install 'lotus-harness[openmed]' or openmed
# LOTUS_OPENMED_DISABLE=0

# Unified context orchestrator budget (characters across all inject blocks)
# LOTUS_CONTEXT_BUDGET_CHARS=12000

# Gated LLM-assisted structured extract (```lotus-extract JSON fence)
# LOTUS_LLM_EXTRACT=0

# Opt-in LLM understanding enrichment on crisis / ambiguous turns
# LOTUS_LLM_UNDERSTAND=0
# LOTUS_LLM_UNDERSTAND_MODE=crisis_ambiguous

# Log context block drops (also auto-logs when blocks are trimmed)
# LOTUS_CONTEXT_DEBUG=0

# Careful speech / journey UI
# LOTUS_SPEECH_DISABLE=0
# LOTUS_JOURNEY_UI=1

# Honcho reminder block (Hermes memory provider — configure via: hermes -p lotus memory setup honcho)
# LOTUS_HONCHO_DISABLE=0

# Gated live Hermes smoke (pytest): LOTUS_LIVE_SMOKE=1
# Optional real chat turn after hard-stop check: LOTUS_LIVE_SMOKE_CHAT=1

# Cursor CLI backend (alternate to Hermes model) — uses local `agent` binary
# LOTUS_BACKEND=cursor
# LOTUS_CURSOR_MODEL=cursor-grok-4.5-high-fast
# LOTUS_CURSOR_MODE=ask
# LOTUS_CURSOR_TIMEOUT=180
# Optional: CURSOR_API_KEY=...  (else existing Cursor CLI login)

# Safety / core kill-switches (leave unset in production)
# LOTUS_SAFETY_DISABLE=0
# LOTUS_REALTIME_DISABLE=0
# LOTUS_CONTINUITY_DISABLE=0
# LOTUS_MOMENTS_DISABLE=0
# LOTUS_COMPOUND_DISABLE=0
# LOTUS_PROFILE_DISABLE=0
